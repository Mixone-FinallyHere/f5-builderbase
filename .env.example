# Add environment variables here. Never commit real secrets.
# Copy to .env.local and fill in. In production these are set in the Vercel dashboard.

# Upstash Redis (Vercel Storage > Upstash). Stores the /slides deck.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Team password for editing /slides. Editing is disabled when unset.
EDIT_PASSWORD=

# Gemini for Kate's wording (optional: templates are used when unset). One of:
#   GEMINI_API_KEY=            Gemini Developer API key
#   GCP_SA_KEY= GCP_PROJECT_ID= GCP_LOCATION=   Vertex AI in our Google Cloud project; SA key as base64 JSON, location "global" or e.g. us-east1
GEMINI_MODEL=gemini-2.5-flash

# Signs the demo session cookie (falls back to EDIT_PASSWORD).
SESSION_SECRET=

# Kate's interactive chat in the demo (optional: a scripted responder answers when unset).
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5
